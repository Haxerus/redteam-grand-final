# RTH organizer bootloader for the Orqa DTK APB flight controller (STM32H743).
# Derived from upstream OrqaH7QuadCore/hwdef-bl.dat. Changes: board ID 1189 (Orqa APB factory ID,
# matches Orqa_ArduPilot_Ports OrqaAPB targets), microSD removed (on the APB, PC10/PC11/PC12/PD2 are
# UART4/UART5 to the i.MX), USB identity as the APB application (35b6:0090).
MCU STM32H7xx STM32H743xx
APJ_BOARD_ID 1189
OSCILLATOR_HZ 8000000
FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 384

USB_VENDOR 0x35b6
USB_PRODUCT 0x0090
USB_STRING_MANUFACTURER "Orqa"
USB_STRING_PRODUCT "OrqaAPB-BL"

SERIAL_ORDER OTG1
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# chip selects held inactive
PB12 FLASH1_CS CS
PA15 OSD1_CS CS
PA4 GYRO1_CS CS
PE11 GYRO2_CS CS
PD0 CAM_SW OUTPUT LOW

PA8 LED_BOOTLOADER OUTPUT LOW
define HAL_LED_ON 1
define HAL_LED_OFF 0
